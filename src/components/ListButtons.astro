---
export const prerender = true;

const { activeList } = Astro.props;
---

<div class="container mx-auto px-4">
  <div class="flex flex-row">
    {
      Array.from({ length: 26 }, (_, i) => (
        <button
          class={`listButton flex justify-center items-center w-full bg-accent-dark ${activeList?.listName == String.fromCharCode(65 + i) && "active"} text-white rounded-sm font-medium mx-1 py-2 hover:bg-accent-light transition ease-in-out duration-150`}
        >
          {String.fromCharCode(65 + i)}
        </button>
      ))
    }
  </div>
</div>
<style>
  .active {
    background-color: #dc3636;
  }
</style>
<script>
  document.addEventListener("astro:page-load", async () => {
    const listButtons = document.querySelectorAll(".listButton");
    listButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const activate = await fetch(
          `${window.location.origin}/api/v1/list/active`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              name: button.innerHTML.trim(),
            }),
          }
        );
        const parsedJson = await activate.json();
        if (parsedJson?.modifiedCount == 2) {
          listButtons.forEach((btn) => btn.classList.remove("active"));
          button.classList.add("active");
        }
      });
    });
  });
</script>
