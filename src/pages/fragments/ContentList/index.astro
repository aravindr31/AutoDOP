---
import AccountTable from "../../../components/AccountTable.astro";
import InternalError from "../../../components/InternalError.astro";
import ListButtons from "../../../components/ListButtons.astro";

const pageValue = Astro.url.searchParams.get("page") || 1;

let isError = false;
let total_pages = 1;
let contentArray: any[] = [];
let retries = 5;
let totalItems = 0;
let activeList: any = null;
const fetchContentFromDB = async () => {
  try {
    const fetchAccount = fetch(
      `${Astro.url.origin}/api/v1/accounts/getAllAccounts?page=${pageValue}`,
      {
        method: "GET",
      }
    );
    const fetchActive = fetch(`${Astro.url.origin}/api/v1/list/active`, {
      method: "GET",
    });
    const [accountsResponse, activeResponse] = await Promise.all([
      fetchAccount,
      fetchActive,
    ]);
    if (!accountsResponse.ok)
      throw new Error(
        `DB Fetch failed while getting Accounts ${response.status}`
      );
    if (!activeResponse.ok)
      throw new Error(
        `DB Fetch failed while checking active List${response.status}`
      );

    const AccountRes = await accountsResponse.json();
    activeList = await activeResponse.json();
    total_pages = AccountRes?.totalPages;
    totalItems = AccountRes?.totalItems;
    contentArray = AccountRes.accounts;
  } catch (error) {
    if (retries > 0) {
      retries--;
      console.log(`Retrying fetch.. Total retires left - ${retries}`);
      await fetchContentFromDB();
    } else {
      isError = true;
      console.error(error);
    }
  }
};
await fetchContentFromDB();
---

{
  isError ? (
    <InternalError />
  ) : (
    <div class="container mx-auto px-4 pt-16 mb-16">
      <ListButtons activeList={activeList} />
      <AccountTable content={contentArray} />
    </div>
  )
}
